# Copy to backend/.env and adjust. Never commit the real .env file.
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/workshop_dw

# Alternative to DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workshop_dw
DB_USER=postgres
DB_PASSWORD=change_me

# Isolated database for pytest (default: <DB_NAME>_test). Must end with "_test".
# TEST_DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/workshop_dw_test

APP_ENV=development
LOG_LEVEL=INFO
BATCH_SIZE=5000
RANDOM_SEED=42
MAX_UPLOAD_MB=200
# Comma-separated origins allowed to call the API (the Vite dev server and preview)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional path overrides (relative paths are resolved from backend/)
# DATASETS_DIR=../other/datasets
# REPORTS_DIR=../other/reports
# SQL_DIR=../other/sql
