# Copy to .env and adjust. Never commit the real .env file.

# Full SQLAlchemy URL (takes precedence over the DB_* variables below)
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/ecommerce_dw

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dw
DB_USER=postgres
DB_PASSWORD=change_me

# Optional: isolated database for pytest. Default = <DB_NAME>_test on the same server.
# The test suite refuses to touch any database whose name does not end in "_test".
# TEST_DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/ecommerce_dw_test

LOG_LEVEL=INFO
BATCH_SIZE=5000
RANDOM_SEED=42

# Optional overrides
# SOURCE_DATA_DIR=data/raw
# REPORTS_DIR=reports
# LOGS_DIR=logs
# SOURCE_SYSTEM=ecommerce_oltp
